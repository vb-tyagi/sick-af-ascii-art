{
  "name": "sick-af-ascii-art-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Image & video to ASCII/dither art. 15 render modes, Canvas 2D, fully client-side.",
  "scripts": {
    "dev": "pnpm --filter @sick-af/web dev",
    "build": "pnpm --filter @sick-af/web build",
    "preview": "pnpm --filter @sick-af/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.2",
    "@sick-af/engine": "workspace:*",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vite-node": "^2.1.8"
  }
}